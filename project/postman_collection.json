    {
      "name": "1. Register New Customer User (201 Created)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Student User\",\n  \"email\": \"student_{{$randomInt}}@example.com\",\n  \"password\": \"SecurePass@123\",\n  \"role\": \"customer\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "2. Register User Duplicate Email (409 Conflict)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Duplicate Customer\",\n  \"email\": \"customer@battechno.com\",\n  \"password\": \"Customer@123456\",\n  \"role\": \"customer\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "3. Valid Login (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JWT token is returned', function () { pm.expect(jsonData.token).to.be.a('string').and.not.empty; });",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('customerToken', jsonData.token);",
              "}",
              "pm.visualizer.set('<h2>Valid Login - 200 OK</h2><p><b>JWT returned:</b> Yes (value hidden for security)</p><p><b>User:</b> {{name}}</p><p><b>Role:</b> {{role}}</p>', { name: jsonData.user.name, role: jsonData.user.role });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@battechno.com\",\n  \"password\": \"Customer@123456\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
