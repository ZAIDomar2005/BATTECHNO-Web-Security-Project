    {
      "name": "15. Inspect Security Response Headers (Helmet Verification)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Helmet headers are present', function () {",
              "    pm.expect(pm.response.headers.get('x-content-type-options')).to.eql('nosniff');",
              "    pm.expect(pm.response.headers.get('x-frame-options')).to.exist;",
              "    pm.expect(pm.response.headers.get('content-security-policy')).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
